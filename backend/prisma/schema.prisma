// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

///////////////////////////
// ENUMS
///////////////////////////

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  INTERN
}

///////////////////////////
// MODELS
///////////////////////////

model User {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  password    String
  role        Role      @default(EMPLOYEE)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  parentId    Int?      // points to immediate superior
  parent      User?     @relation("Hierarchy", fields: [parentId], references: [id])
  subordinates User[]   @relation("Hierarchy")
  messagesSent     Message[] @relation("MessagesSent")
  messagesReceived Message[] @relation("MessagesReceived")
  filesOwned       File[]
  teamsManaged     Team[]
  teamMemberships  Team[] @relation("TeamMembers")
  groupMemberships Group[] @relation("GroupMembers")
  auditLogs        AuditLog[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int?      // null if group message
  groupId    Int?      // optional for group messages
  content    String
  timestamp  DateTime @default(now())

  sender     User @relation("MessagesSent", fields: [senderId], references: [id])
  receiver   User? @relation("MessagesReceived", fields: [receiverId], references: [id])
  group      Group? @relation(fields: [groupId], references: [id])
}

model Group {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  members     User[]    @relation("GroupMembers")
  messages    Message[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model File {
  id           Int      @id @default(autoincrement())
  ownerId      Int
  fileName     String   // Original file name
  mimeType     String   // File MIME type
  size         Int      // File size in bytes
  s3Key        String   @unique // S3 object key
  s3Url        String?  // Pre-signed URL (temporary)
  allowedRole  Role     // minimal role required to access
  description  String?  // Optional file description
  isActive     Boolean  @default(true) // Soft delete
  downloadCount Int     @default(0) // Track downloads
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([allowedRole])
  @@index([isActive])
}

model Team {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  managerId   Int
  members     User[]   @relation("TeamMembers")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager User @relation(fields: [managerId], references: [id])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String   // e.g., "CREATE_USER", "DELETE_TEAM", "OVERRIDE_RBAC"
  entity      String   // e.g., "User", "Team", "Message", "File"
  entityId    Int?     // ID of the affected entity
  details     String?  // Human-readable description
  metadata    Json?    // Additional structured data
  ipAddress   String?  // Client IP address
  userAgent   String?  // Client user agent
  timestamp   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([timestamp])
}

///////////////////////////
// NOTES
///////////////////////////
// 1. User hierarchy implemented via `parentId` and `subordinates`
// 2. Messaging supports 1-to-1 and group messages (groupId optional)
// 3. Files enforce minimal role access via allowedRole
// 4. Teams link a manager to their members (used for RBAC enforcement)
// 5. AuditLog tracks all admin actions and system events for compliance
