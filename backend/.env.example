# PostgreSQL. DIRECT_URL is used for migrations; DATABASE_URL may point at a connection pooler.
DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<database>"
DIRECT_URL="postgresql://<username>:<password>@<host>:<port>/<database>"

# Signs login tokens. Required: the server will not start without it. Generate with: openssl rand -hex 32
JWT_SECRET=your-very-secure-secret
# JWT_EXPIRES_IN="24h"

# API port and the browser origin allowed by CORS (also used in password-reset links)
# PORT=3000
# FRONTEND_URL="http://localhost:5173"

# First admin account, created by `npm run seed` (safe to run again)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
# ADMIN_NAME="Administrator"

# S3-compatible object storage. The names say R2, but any S3 API works (Cloudflare R2, SeaweedFS, ...)
R2_ENDPOINT="https://<your-cloudflare-account-id>.r2.cloudflarestorage.com"
R2_REGION="auto"
R2_ACCESS_KEY_ID="<your-r2-access-key-id>"
R2_SECRET_ACCESS_KEY="<your-r2-secret-access-key>"
R2_BUCKET_NAME="<your-r2-bucket-name>"
# Only if browsers reach storage at a different address than the server does (Docker):
# R2_PUBLIC_ENDPOINT="http://localhost:8333"
# Set to "true" only for local S3-compatible servers that need path-style URLs
# R2_FORCE_PATH_STYLE="true"

# File Upload Configuration
MAX_FILE_SIZE="10485760" # 10MB in bytes
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"

# Email (password reset). Defaults suit a local SMTP catcher such as Mailpit on port 1025.
# SMTP_HOST="localhost"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"      # "true" for implicit TLS (port 465)
# SMTP_IGNORE_TLS="false"  # "true" to skip STARTTLS on a trusted network
# MAIL_FROM="OrgNet <noreply@example.com>"
