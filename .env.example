# Copy to .env and fill in. Used by `docker compose up --build`.

# Host ports
FRONTEND_PORT=5160
BACKEND_PORT=3060
POSTGRES_PORT=5460
S3_PORT=8333
MAILPIT_PORT=8025

# Name the browser uses to reach this machine. Change it if others open the app over the network.
PUBLIC_HOST=localhost

POSTGRES_PASSWORD=change-me
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# First admin account, created on first start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Object storage credentials (any values; the bucket is created automatically)
S3_ACCESS_KEY=orgnet-access
S3_SECRET_KEY=change-me

# Mail. The default catches every email in Mailpit (http://localhost:MAILPIT_PORT) instead of sending it.
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=OrgNet <noreply@orgnet.local>

# To deliver real email, point these at an SMTP relay (a provider's SMTP server). Example for Gmail
# (needs 2-Step Verification and an app password; the From address must be that same account):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_IGNORE_TLS=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-character-app-password
#   MAIL_FROM=OrgNet <you@gmail.com>
# Sending straight from this machine (SMTP_HOST=postfix with `--profile direct-mail`) is blocked by
# Gmail for home and most hosting IPs, so it only works from a clean, well-known server address.
MAIL_DOMAIN=orgnet.local
